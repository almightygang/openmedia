{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Openmedia",
  "version": "0.1.0",
  "identifier": "com.openmedia.desktop",
  "build": {
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Openmedia",
        "width": 1320,
        "height": 800,
        "backgroundColor": "#09090b",
        "decorations": false,
        "transparent": false,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "rpm", "appimage", "nsis"],
    "externalBin": ["binaries/ffmpeg"],
    "category": "Entertainment",
    "shortDescription": "Anime desktop app",
    "longDescription": "Openmedia — easy-to-use desktop anime application with a provider-based architecture.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "depends": ["libwebkit2gtk-4.1-0", "libgtk-3-0"]
      }
    }
  },
  "plugins": {
    "deepLink": {
      "domains": []
    },
    "updater": {
      "active": true,
      "endpoints": ["https://github.com/REPLACE_OWNER/openmedia/releases/latest/download/latest.json"],
      "dialog": false,
      "pubkey": "REPLACE_UPDATER_PUBKEY"
    }
  }
}
